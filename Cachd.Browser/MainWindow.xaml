<Window x:Class="Cachd.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Cachd"
        Width="1280"
        Height="820"
        MinWidth="850"
        MinHeight="550"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{StaticResource AppFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="6"
            CornerRadius="10"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#051014"/>
        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#101A20"/>
        <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#0B151A"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#202B32"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#34434B"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#34434B"/>
        <SolidColorBrush x:Key="SelectedTabBrush" Color="#26333B"/>
        <SolidColorBrush x:Key="PanelCardBrush" Color="#16232A"/>
        <SolidColorBrush x:Key="PanelCardBorderBrush" Color="#263840"/>
        <SolidColorBrush x:Key="PanelCardHoverBorderBrush" Color="#6C5B32"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB4BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D9B141"/>
        <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#051014"/>

        <Style x:Key="TrafficButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="14"/>
            <Setter Property="Height"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="38"/>
            <Setter Property="Height"
                    Value="36"/>
            <Setter Property="Margin"
                    Value="2,0"/>
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="17"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ControlHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedToolbarButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource ToolbarBackgroundBrush}"/>
            <Setter Property="Padding"
                    Value="12,7"/>
            <Setter Property="Margin"
                    Value="3,5,3,0"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9,9,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                ContentSource="Header"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="TabBackground"
                                        Property="Background"
                                        Value="{DynamicResource SelectedTabBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TabBackground"
                                        Property="Background"
                                        Value="{DynamicResource ControlBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ToolbarBackgroundBrush}"
                    Padding="15,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource TrafficButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseWindow_Click"
                                ToolTip="Закрити">
                            <Ellipse Width="13"
                                     Height="13"
                                     Fill="#FF5F57"/>
                        </Button>

                        <Button Style="{StaticResource TrafficButton}"
                                Margin="9,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click"
                                ToolTip="Згорнути">
                            <Ellipse Width="13"
                                     Height="13"
                                     Fill="#FEBC2E"/>
                        </Button>

                        <Button Style="{StaticResource TrafficButton}"
                                Margin="9,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click"
                                ToolTip="Розгорнути">
                            <Ellipse Width="13"
                                     Height="13"
                                     Fill="#28C840"/>
                        </Button>

                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="cachd"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            x:Name="IntelligenceToggleButton"
                            Style="{StaticResource RoundedToolbarButton}"
                            Content="✦"
                            Width="34"
                            Height="30"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            FontSize="19"
                            Cursor="Hand"
                            ToolTip="Smart suggestions"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="IntelligenceToggle_Click"/>

                </Grid>
            </Border>

            <DockPanel Grid.Row="1"
                       Background="{DynamicResource TabStripBackgroundBrush}"
                       LastChildFill="True">

                <Button DockPanel.Dock="Right"
                        x:Name="NewTabButton"
                        Style="{StaticResource RoundedToolbarButton}"
                        Content="+"
                        Width="36"
                        Margin="4,3,8,3"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        Foreground="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        FontSize="20"
                        Cursor="Hand"
                        Click="NewTab_Click"/>

                <TabControl x:Name="BrowserTabs"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionChanged="BrowserTabs_SelectionChanged">

                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          VerticalAlignment="Bottom"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                </TabControl>
            </DockPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource ToolbarBackgroundBrush}"
                    Padding="12,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Button Style="{StaticResource NavButton}"
                                Content="←"
                                Click="BackButton_Click"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="→"
                                Click="ForwardButton_Click"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="↻"
                                Margin="2,0,10,0"
                                Click="ReloadButton_Click"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="11"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SecurityIcon"
                                       Text="◈"
                                       Foreground="#28C840"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <TextBox x:Name="AddressBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Padding="4,7"
                                     VerticalContentAlignment="Center"
                                     KeyDown="AddressBox_KeyDown"/>

                            <ProgressBar x:Name="PageLoadingIndicator"
                                         Grid.Column="1"
                                         Height="2"
                                         Margin="4,0,8,1"
                                         VerticalAlignment="Bottom"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Visibility="Collapsed"/>

                        </Grid>
                    </Border>
                    <Button Grid.Column="2"
                            x:Name="OfflineModeToggleButton"
                            Style="{StaticResource RoundedToolbarButton}"
                            Content="Offline: OFF"
                            MinWidth="105"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="10,0"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OfflineModeToggle_Click"/>
                    <Button Grid.Column="3"
                            x:Name="GoButton"
                            Content="Go"
                            Width="36"
                            Height="36"
                            Margin="10,0,0,0"
                            Background="#D9B141"
                            Foreground="{DynamicResource PrimaryActionTextBrush}"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="GoButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Opacity"
                                                Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Opacity"
                                                Value="0.75"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>
            </Border>
            <Grid Grid.Row="3"
                  ClipToBounds="True">

                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        ClipToBounds="True">

                    <ContentControl x:Name="BrowserHost"/>

                </Border>

                <Border x:Name="IntelligencePanel"
                        Panel.ZIndex="10"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="360"
                        Margin="12"
                        Background="{DynamicResource ToolbarBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="5"
                                          Opacity="0.32"
                                          Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="✦"
                                           FontSize="21"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="11,0,6,0">
                                <TextBlock x:Name="IntelligenceTitle"
                                           Text="Your suggestions"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="IntelligenceSubtitle"
                                           Text="Pages you may want to visit next"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button x:Name="IntelligenceCloseButton"
                                    Grid.Column="2"
                                    Content="×"
                                    Width="30"
                                    Height="30"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    FontSize="18"
                                    Cursor="Hand"
                                    ToolTip="Close suggestions"
                                    Click="IntelligenceToggle_Click"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IntelligenceSectionTitle"
                                       Text="UP NEXT"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Height="1"
                                    Margin="12,0"
                                    Background="{DynamicResource ControlBorderBrush}"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="IntelligenceCount"
                                       Grid.Column="2"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox x:Name="PredictionsList"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="PredictionsList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SuggestionCard"
                                                        Margin="0,0,0,8"
                                                        Padding="12"
                                                        Background="{DynamicResource PanelCardBrush}"
                                                        BorderBrush="{DynamicResource PanelCardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="11">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SuggestionCard" Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                                        <Setter TargetName="SuggestionCard" Property="BorderBrush" Value="{DynamicResource PanelCardHoverBorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SuggestionCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30"
                                                Height="30"
                                                CornerRadius="9"
                                                Background="{DynamicResource ControlBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="↗"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="›"
                                                   Margin="8,0,2,0"
                                                   FontSize="22"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="IntelligenceEmptyState"
                                   Grid.Row="2"
                                   Text="Browse a few pages and helpful suggestions will show up here."
                                   Margin="8,28"
                                   FontSize="13"
                                   LineHeight="21"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Row="3"
                                Margin="0,10,0,0"
                                Padding="11,10"
                                Background="{DynamicResource PanelCardBrush}"
                                BorderBrush="{DynamicResource PanelCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock x:Name="IntelligenceTip"
                                       Text="Suggestions improve as you browse."
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>

                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
