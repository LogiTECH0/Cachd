<Window x:Class="Cachd.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Cachd"
        Width="1280"
        Height="820"
        MinWidth="850"
        MinHeight="550"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#051014"
        Foreground="#E8E8E8"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="TrafficButton"
                TargetType="Button">
            <Setter Property="Width"
                    Value="14"/>
            <Setter Property="Height"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton"
                TargetType="Button">
            <Setter Property="Width"
                    Value="38"/>
            <Setter Property="Height"
                    Value="36"/>
            <Setter Property="Margin"
                    Value="2,0"/>
            <Setter Property="Background"
                    Value="#202B32"/>
            <Setter Property="Foreground"
                    Value="#E8E8E8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="17"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                        Value="True">
                    <Setter Property="Background"
                            Value="#34434B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground"
                    Value="#AAB4BA"/>
            <Setter Property="Background"
                    Value="#101A20"/>
            <Setter Property="Padding"
                    Value="12,7"/>
            <Setter Property="Margin"
                    Value="3,5,3,0"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9,9,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                ContentSource="Header"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="TabBackground"
                                        Property="Background"
                                        Value="#26333B"/>
                                <Setter Property="Foreground"
                                        Value="#D9B141"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="TabBackground"
                                        Property="Background"
                                        Value="#202B32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#051014">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#101A20"
                    Padding="15,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource TrafficButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseWindow_Click"
                                ToolTip="Закрити">
                            <Ellipse Width="13"
                                    Height="13"
                                     Fill="#FF5F57"/>
                        </Button>

                        <Button Style="{StaticResource TrafficButton}"
                                Margin="9,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click"
                                ToolTip="Згорнути">
                            <Ellipse Width="13"
                                    Height="13"
                                     Fill="#FEBC2E"/>
                        </Button>

                        <Button Style="{StaticResource TrafficButton}"
                                Margin="9,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click"
                                ToolTip="Розгорнути">
                            <Ellipse Width="13"
                                    Height="13"
                                     Fill="#28C840"/>
                        </Button>

                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="cachd"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#D9B141"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            x:Name="IntelligenceToggleButton"
                            Content="◈"
                            Width="34"
                            Height="30"
                            Background="#202B32"
                            Foreground="#D9B141"
                            BorderThickness="0"
                            FontSize="19"
                            Cursor="Hand"
                            ToolTip="Cachd Intelligence"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="IntelligenceToggle_Click"/>

                </Grid>
            </Border>

            <DockPanel Grid.Row="1"
                       Background="#0B151A"
                       LastChildFill="True">

                <Button DockPanel.Dock="Right"
                        Content="+"
                        Width="36"
                        Margin="4,3,8,3"
                        Background="#202B32"
                        Foreground="#D9B141"
                        BorderThickness="0"
                        FontSize="20"
                        Cursor="Hand"
                        Click="NewTab_Click"/>

                <TabControl x:Name="BrowserTabs"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionChanged="BrowserTabs_SelectionChanged">

                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          VerticalAlignment="Bottom"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                </TabControl>
            </DockPanel>

            <Border Grid.Row="2"
                    Background="#101A20"
                    Padding="12,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Button Style="{StaticResource NavButton}"
                                Content="←"
                                Click="BackButton_Click"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="→"
                                Click="ForwardButton_Click"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="↻"
                                Margin="2,0,10,0"
                                Click="ReloadButton_Click"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#202B32"
                            CornerRadius="11"
                            BorderBrush="#34434B"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SecurityIcon"
                                       Text="◈"
                                       Foreground="#28C840"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <TextBox x:Name="AddressBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#E8E8E8"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Padding="4,7"
                                     VerticalContentAlignment="Center"
                                     KeyDown="AddressBox_KeyDown"/>

                        </Grid>
                    </Border>

                    <Button Grid.Column="2"
                            x:Name="GoButton"
                            Content="Перейти"
                            Width="90"
                            Height="36"
                            Margin="10,0,0,0"
                            Background="#D9B141"
                            Foreground="#051014"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="GoButton_Click"/>

                </Grid>
            </Border>
            <Grid Grid.Row="3"
                    ClipToBounds="True">

                <Border Background="#051014"
                        ClipToBounds="True">

                    <ContentControl x:Name="BrowserHost"/>

                </Border>

                <Border x:Name="IntelligencePanel"
                        Panel.ZIndex="10"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="320"
                        Background="#101A20"
                        BorderBrush="#6C4C96"
                        BorderThickness="1,0,0,0"
                        Padding="16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Cachd Intelligence"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#D9B141"/>

                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Background="Transparent"
                                    Foreground="#AAB4BA"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="IntelligenceToggle_Click"/>
                        </DockPanel>

                        <ListBox x:Name="PredictionsList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 Foreground="#E8E8E8"
                                 BorderThickness="0"
                                 FontSize="13"/>
                    </Grid>

                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
